							}
							?>
						</td>
						<td>
							<?php
							if(!empty($trade_stat ["entry"])) {
								?>
								<?= Stuff::format_float_significative($trade_stat ["entry"] ["quote"], 6) ?> <?= $trade_stat ["quote_asset"] ?> <br/>
								@ <?= Stuff::format_float_significative($trade_stat ["entry"] ["avg"], 6) ?> <?= $trade_stat ["quote_asset"] ?> / <?= $trade_stat ["base_asset"] ?>
								<?php
							}
							?>
						</td>
						<td>
							<?php
							if(!empty($trade_stat ["exit"])) {
								?>
								<?= Stuff::format_float_significative($trade_stat ["exit"] ["quote"], 6) ?> <?= $trade_stat ["quote_asset"] ?> <br/>
								@ <?= Stuff::format_float_significative($trade_stat ["exit"] ["avg"], 6) ?> <?= $trade_stat ["quote_asset"] ?> / <?= $trade_stat ["base_asset"] ?>
								<?php
							}
							?>
						</td>
					</tr>
				<?php
				}
