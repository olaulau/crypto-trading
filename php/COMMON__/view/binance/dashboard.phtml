function dashboard_row (string $asset, ?Account $account, array $assets_reference_price, array $balances, array $balance_reference_qty, bool $can_hide, array $pending_orders_by_asset)
{
	if (!empty($account)) {
		$account_quantity = $account->get_quantity();
		$account_reference_qty = $account_quantity * ($assets_reference_price [$asset] ?? 0);
	}
	else {
		$account_quantity = $balances [$asset] ?? 0;
		$account_reference_qty = $balance_reference_qty [$asset] ?? 0;
	}
	?>
					<tr class="<?= ($can_hide && $account_reference_qty >= 0 && $account_reference_qty < Binance::reference_dust_threashold) ? "dust d-none" : "" ?>">
						<td class="text-end">
							<?= $asset ?> <br/>
							<span class="text-secondary"><?= $capital_configs [$asset] ["name"] ?? "" ?></span>
						</td>
						
						<td class="text-start">
							<?php
							if(!empty($account)) {
								?>
								<?= Stuff::format_crypto ($account_quantity) ?>
								<?= ($asset === BinanceFiatApi::fiat_asset) ? " €" : "" ?>
								<?= ($asset === BinanceRestApi::dividendes_asset) ? " USDC" : "" ?>
								<br/>
								<?php
								if(!empty($assets_reference_price [$asset])) {
									?>
									<span class="text-secondary"><?= Stuff::format_fiat ( $account_reference_qty ) ?> <?= Binance::reference_asset ?></span>
									<?php
								}
								?>
								<?php
							}
							else {
								?>
								&nbsp;
								<?php
							}
							?>
						</td>

						<td class="text-start balance_cell">
							<?php
							if (!empty($balances [$asset])) {
								?>
								<?= Stuff::format_crypto ($balances [$asset]) ?> <br/>
								<span class="text-secondary"><?= Stuff::format_fiat ($balance_reference_qty [$asset]) ?> <?= Binance::reference_asset ?></span>
								<?php
							}
							else {
								?>
								&nbsp;
								<?php
							}
							?>
						</td>

						<td class="text-start">
							<?php
							if (!empty($assets_reference_price [$asset])) {
								?>
								1 = <br/>
								<?= Stuff::format_crypto ($assets_reference_price [$asset]) ?>
								<?php
							}
							else {
								?>
								&nbsp;
								<?php
							}
							?>
						</td>
						
						<td class="">
							<?= "" ?>
						</td>

						<td class="">
							<?php
							if(!empty($pending_orders_by_asset [$asset])) {
								$orders = $pending_orders_by_asset [$asset];
								foreach ($orders as $order) {
									if (in_array($order ["type"], ["STOP_LOSS_LIMIT", "LIMIT_MAKER"])) {
										?>
										<?= $order ["type"] === "STOP_LOSS_LIMIT" ? "SL" : "TP" ?> 
										<?= Stuff::format_crypto ($order ["reference_quantity"]) ?> <?= Binance::reference_asset ?>
										(<?= Stuff::format_percent ($order ["reference_quantity"] / $account_reference_qty * 100 , false) ?>)
										@ <?= Stuff::format_crypto ($order ["reference_stop"] )?>
										(<?= Stuff::format_percent( ( $order ["reference_stop"] - $assets_reference_price [$asset] ) / $assets_reference_price [$asset] * 100 ) ?>)
										<?php
									}
									else {
										?>
										<?= $order ["side"] ?> 
										<?= Stuff::format_crypto ($order ["reference_quantity"]) ?> <?= Binance::reference_asset ?>
										@ <?= Stuff::format_crypto ($order ["reference_stop"] )?>
										(<?= Stuff::format_percent( ( $order ["reference_stop"] - $assets_reference_price [$asset] ) / $assets_reference_price [$asset] * 100 ) ?>)
										<?php
									}
									?>
									<br/>
									<?php
								}
								?>
								<?php
							}
							?>
						</td>
					</tr>
	<?php
}
