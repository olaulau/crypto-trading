							<?= $trade_stat ["base_asset"] ?>
						</td>
						<td>
							<?= $trade_stat ["quote_asset"] ?>
						</td>
						<td>
							<?= Stuff::format_float_significative($trade_stat ["price"], 6) ?> <?= $trade_stat ["quote_asset"] ?> / <?= $trade_stat ["base_asset"] ?>
						</td>
						<td>
							<?php
							if(!empty($trade_stat ["balance"] )) {
								$low_balance = $trade_stat ["quote_balance"] < Binance::quote_dust_threashold;
								?>
								<span class="<?= $low_balance ? "text-secondary" : "" ?>">
									<?= Stuff::format_float_significative($trade_stat ["balance"], 6) ?> <?= $trade_stat ["base_asset"] ?> <br/>
