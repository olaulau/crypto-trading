function dashboard_row (Account $account, $assets_reference_price, $balances, $balance_reference_qty, bool $can_hide)
{
	$asset = $account->get_asset();
	$account_reference_qty = $account->get_quantity() * ($assets_reference_price [$asset] ?? 0);
	?>
					<tr class="<?= ($can_hide && $account_reference_qty >= 0 && $account_reference_qty < Binance::reference_dust_threashold) ? "dust visually-hidden" : "" ?>">
						<td class="text-end">
							<?= $account->get_asset() ?> <br/>
							<span class="text-secondary"><?= $capital_configs [$asset] ["name"] ?? "" ?></span>
						</td>
						
						<td class="text-start">
							<?= Stuff::format_crypto ($account->get_quantity()) ?>
							<?= ($account->get_asset() === BinanceFiatApi::fiat_asset) ? " €" : "" ?>
							<?= ($account->get_asset() === BinanceRestApi::dividendes_asset) ? " USDC" : "" ?>
							<br/>
							<?php
							if(!empty($assets_reference_price [$asset])) {
								?>
								<span class="text-secondary"><?= Stuff::format_fiat ( $account_reference_qty ) ?> <?= Binance::reference_asset ?></span>
								<?php
							}
							?>
						</td>

						<?php
						if (!empty($balances [$asset])) {
							?>
							<td class="text-start balance_cell d-none">
								<?= Stuff::format_crypto ($balances [$asset]) ?> <br/>
								<span class="text-secondary"><?= Stuff::format_fiat ($balance_reference_qty [$asset]) ?> <?= Binance::reference_asset ?></span>
							</td>
							<?php
						}
						else {
							?>
							<td class="balance_cell d-none">&nbsp;</td>
							<?php
						}
						?>

						<?php
						if (!empty($assets_reference_price [$asset])) {
							?>
							<td class="text-start">
								1 = <br/>
								<?= Stuff::format_crypto ($assets_reference_price [$asset]) ?>
							</td>
							<?php
						}
						else {
							?>
							<td>&nbsp;</td>
							<?php
						}
						?>
						
						<td class="">
							<?= "" ?>
						</td>

						<td class="">
							<?= "" ?>
						</td>

						<td class="">
							<?= "" ?>
						</td>
					</tr>
	<?php
}
